# Python-overlay build: replace vllm_ascend's Python layer in an existing image.
#
# The base image already carries the CANN 9.2.0 stack, torch-npu, flash-attn and
# the compiled vllm_ascend_C extension, so this only needs to swap Python
# sources. That is much faster than a native rebuild and needs no CANN payload,
# no LFS objects and no aarch64 toolchain -- but it is only correct while
# csrc/ is unchanged, which ci/build.sh verifies against the base image's
# recorded source commit before calling this recipe.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Identity of the source being installed; supplied by ci/build.sh.
ARG VLLM_ASCEND_VERSION=0.0.0
ARG VLLM_ASCEND_COMMIT=unknown
ARG VLLM_ASCEND_BASE_VERSION=unknown
ARG VLLM_ASCEND_BASE_IMAGE=unknown

COPY vllm_ascend-src.tar /tmp/vllm_ascend-src.tar
COPY sync_python_overlay.py /tmp/sync_python_overlay.py
COPY deleted-modules.txt /tmp/deleted-modules.txt

RUN set -euo pipefail && \
    mkdir -p /tmp/vllm-ascend-src && \
    tar -xf /tmp/vllm_ascend-src.tar -C /tmp/vllm-ascend-src && \
    python3 /tmp/sync_python_overlay.py \
        --source /tmp/vllm-ascend-src/vllm_ascend \
        --target /opt/upgrade/.venv/lib/python3.12/site-packages/vllm_ascend \
        --version "${VLLM_ASCEND_VERSION}" \
        --commit "${VLLM_ASCEND_COMMIT}" \
        --base-version "${VLLM_ASCEND_BASE_VERSION}" \
        --deleted-list /tmp/deleted-modules.txt && \
    rm -rf /tmp/vllm-ascend-src /tmp/vllm_ascend-src.tar /tmp/sync_python_overlay.py /tmp/deleted-modules.txt

# Same import smoke test the native recipe uses, so a broken overlay cannot ship.
RUN /opt/upgrade/.venv/bin/python -c 'import vllm_ascend, vllm; print(vllm_ascend.__file__, vllm.__file__)'

LABEL step5.build.mode="python-overlay" \
      step5.vllm-ascend.version="${VLLM_ASCEND_VERSION}" \
      step5.vllm-ascend.commit="${VLLM_ASCEND_COMMIT}" \
      step5.vllm-ascend.base_version="${VLLM_ASCEND_BASE_VERSION}" \
      step5.vllm-ascend.overlay_of="${VLLM_ASCEND_BASE_IMAGE}"

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "/opt/upgrade/cann92-entrypoint.sh"]
