FROM docker.io/library/step5-fp8-a5:modelslim-a2ac-wheel-20261016@sha256:c139edabf0467dfaa0063eabf7e2d4cd229439b362525e8da5b21bd1871f6f4c AS candidate
ARG FEATURE_COMMIT
ARG FEATURE_TREE
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV TORCH_DEVICE_BACKEND_AUTOLOAD=0 PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1
# 快速路径输入：新源码 tar + pin + 替换脚本（无 source.bundle：不做 git 操作）
COPY source.tar source-input.json fast_replace.py /opt/step5/feature-inputs/
WORKDIR /tmp
# 1) 源码替换：只覆盖变更的 Python 文件到 source checkout 与已安装包；
#    fast_replace.py 内置门禁（触及 csrc/二进制即拒绝）。
RUN --network=none \
    python3 -B /opt/step5/feature-inputs/fast_replace.py && \
    python3 -c "import vllm_ascend; print('import ok:', vllm_ascend.__file__)" && \
    rm -rf /tmp/fast-source
# 2) CPU 契约测试（与原构建 candidate_probe.tests() 相同的测试集与运行方式）
RUN --network=none \
    source /opt/step5/bin/step5-build-env.sh && \
    mkdir -p /opt/step5/evidence && \
    python3 -B - <<'PY'
import json, subprocess, sys
from pathlib import Path
pin = json.load(open('/opt/step5/feature-inputs/source-input.json'))
paths = ['/vllm-workspace/vllm-ascend/' + p for p in pin['cpu_tests']]
missing = [p for p in paths if not Path(p).is_file()]
if missing:
    sys.exit('cpu_tests missing after replacement: ' + ', '.join(missing))
with open('/opt/step5/evidence/cpu-contracts.log', 'x') as log:
    result = subprocess.run([sys.executable, '-m', 'pytest', '--noconftest', '-p', 'no:cacheprovider',
                             '-q', '--override-ini', 'addopts=',
                             '--junitxml=/opt/step5/evidence/cpu-contracts.xml', *paths],
                            cwd='/tmp', stdout=log, stderr=subprocess.STDOUT)
print('cpu-contracts returncode:', result.returncode)
sys.exit(result.returncode)
PY
WORKDIR /workspace
LABEL step5.ascend.commit=$FEATURE_COMMIT \
      step5.ascend.tree=$FEATURE_TREE \
      step5.ascend.installation=fast-source-replacement \
      step5.base.manifest=sha256:c139edabf0467dfaa0063eabf7e2d4cd229439b362525e8da5b21bd1871f6f4c
ENTRYPOINT ["/bin/bash", "/opt/step5/bin/entrypoint.sh"]
CMD ["/bin/bash"]
