# Historical candidate profile only; default official session build uses pins/official-v030-cann92.json.
# 交付资产定位。CI_DELIVERY_ROOT 由 build.sh 解析（默认 = 本仓库上级目录），
# 可用环境变量 CI_DELIVERY_ROOT 或 build.sh --delivery-root 覆盖。
# 以下变量均可用环境变量预先覆盖。

CI_BUILD_DIR="${CI_BUILD_DIR:-$CI_DELIVERY_ROOT/build}"
CI_IMAGES_DIR="${CI_IMAGES_DIR:-$CI_DELIVERY_ROOT/images}"
CI_WHEELHOUSE_DIR="${CI_WHEELHOUSE_DIR:-$CI_DELIVERY_ROOT/wheelhouse}"
CI_SOURCE_ASSETS_DIR="${CI_SOURCE_ASSETS_DIR:-$CI_DELIVERY_ROOT/source-assets}"
CI_CANN_OPS_DIR="${CI_CANN_OPS_DIR:-$CI_DELIVERY_ROOT/cann-ops}"
CI_CANN_PLATFORM_DIR="${CI_CANN_PLATFORM_DIR:-$CI_DELIVERY_ROOT/cann-platform}"
CI_VLLM_DIR="${CI_VLLM_DIR:-$CI_DELIVERY_ROOT/vllm}"
CI_FINAL_MANIFEST="${CI_FINAL_MANIFEST:-$CI_DELIVERY_ROOT/final-manifest.json}"
