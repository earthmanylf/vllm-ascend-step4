# Machine settings for the DP8/TP4/EP32 four-node Step5 service.
# Copy to cluster.env and edit; the launcher rewrites NODE_IPS/NODE_ID per node.
#
# Trusted file: it is sourced inside the container. Do not fetch it from an
# untrusted source.

# Four node IPs, node0 first. Overridden by `--ips` on the command line.
NODE_IPS=(10.208.128.40 10.208.128.41 10.208.128.42 10.208.128.43)
MASTER_IP="${NODE_IPS[0]}"

# Host path of the Step5 weights; mounted read-only at /model/target.
MODEL_PATH_HOST=/data/models/Step-5-Preview-w8a8-mxfp8

API_PORT=19082
DP_RPC_PORT=13345
HCCL_BASE_PORT=50000

# Topology: 8 data-parallel x TP4 = 32 expert-parallel ranks over 4 nodes.
DP_SIZE=8
TP_SIZE=4
LOCAL_DP_SIZE=2

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_BATCHED_TOKENS=4096

# 0.85 is the validated default. Raising it buys KV capacity (needed for very
# large batches at 128K context) but leaves less headroom for HCCL, which needs
# device memory at init: 0.95 and 0.96 both failed with
# `hcclCommInitRootInfoConfig ... error code is 4`. 0.91 is the highest value
# verified to start and to still admit bs=144 at 128K.
MEMORY_UTILIZATION=0.85
