# Machine settings for the PP4/TP4 two-node Step5 prefill service.
# Copy to cluster.env and edit; the launcher rewrites NODE_IPS/NODE_ID per node.
#
# Trusted file: it is sourced inside the container. Do not fetch it from an
# untrusted source.

# Two node IPs, node0 first. Overridden by `--ips` on the command line.
NODE_IPS=(10.208.128.40 10.208.128.41)
MASTER_IP="${NODE_IPS[0]}"

# Host path of the Step5 weights; mounted read-only at /model/target.
MODEL_PATH_HOST=/data/models/Step-5-Preview-w8a8-mxfp8

# API server (node0 only) and the pipeline-parallel rendezvous port.
API_PORT=10086
PP_MASTER_PORT=7060
HCCL_BASE_PORT=53000

# Topology: pipeline-parallel 4 x TP4 = 16 ranks over 2 nodes, one DP replica.
# PP partitions the 92 decoder layers as 24/25/25/18 across the four stages,
# which is the split validated on this model.
PP_SIZE=4
TP_SIZE=4
DP_SIZE=1
PP_LAYER_PARTITION="24,25,25,18"

MAX_MODEL_LEN=1048576
# Must cover the largest concurrent prefill batch (bs=64): a smaller
# value makes the scheduler queue the tail, so TTFT includes admission
# wait instead of prefill.
MAX_NUM_SEQS=64
MAX_BATCHED_TOKENS=16384

# Prefill runs admit one 128K request per NPU stack, so capacity is not the
# constraint that it is for decode at bs96. 0.92 matches the validated prefill
# recipe; raising it further leaves too little device memory for HCCL init.
MEMORY_UTILIZATION=0.92

# Expert-parallel load balancing. 0 = default, 1 = force eplb so expert
# placement is rebalanced during the run. A switch here (rather than a per-run
# edit) keeps an eplb comparison differing in exactly one place.
FORCE_EPLB=0
