+static void CheckPagedCacheStride(const at::Tensor& cache)
+{
+    TORCH_CHECK(cache.dim() == 4 && cache.size(0) > 0 && cache.size(1) > 0 &&
+                cache.size(2) > 0 && cache.size(3) > 0, "paged cache must be nonempty BNHD");
+    const int64_t row = cache.size(2) * cache.size(3);
+    const int64_t payload = cache.size(1) * row;
+    TORCH_CHECK(cache.stride(3) == 1 && cache.stride(2) == cache.size(3) &&
+                cache.stride(1) == row, "paged cache must have dense inner BNHD rows");
+    TORCH_CHECK(cache.stride(0) >= payload && cache.stride(0) % row == 0,
+                "paged block stride must cover payload and align to an inner row");
+    const int64_t available = cache.storage().nbytes() / cache.element_size() - cache.storage_offset();
+    TORCH_CHECK(available >= payload &&
+                cache.size(0) - 1 <= (available - payload) / cache.stride(0),
+                "paged cache view exceeds its physical storage span");
