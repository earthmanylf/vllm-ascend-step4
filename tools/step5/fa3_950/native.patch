+#ifndef FA3_PAGED_STRIDE_HPP
+#define FA3_PAGED_STRIDE_HPP
+
+#include <cstdint>
+
+// Host validates row divisibility and storage span. Widen before multiplying:
+// physical strides can exceed the logical dense payload by a global tile gap.
+__aicore__ inline int64_t PagedRowIndex(uint32_t block, uint32_t offset,
+                                      uint64_t blockStride, uint64_t rowStride)
+{
+    return static_cast<int64_t>(
+        static_cast<uint64_t>(block) * (blockStride / rowStride) + offset);
+}
+
+#endif
